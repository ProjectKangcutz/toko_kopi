APP_NAME="Pasar Lokal Nusantara"
# Gunakan APP_ENV=production dan APP_DEBUG=false di staging/production
APP_ENV=local
# Generate dengan: php artisan key:generate
APP_KEY=
APP_DEBUG=true
# Gunakan https://domain-anda di staging/production
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
APP_PREVIOUS_KEYS=

# Reverse Proxy (isi IP proxy/load balancer di production, mis. 127.0.0.1)
TRUSTED_PROXIES=

AUTH_GUARD=customer
AUTH_PASSWORD_BROKER=customers
BCRYPT_ROUNDS=12

# Database MySQL 8
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=umkm_online_shop
DB_USERNAME=root
DB_PASSWORD=

# Cache, Session & Queue
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=
# WAJIB true di production HTTPS
SESSION_SECURE_COOKIE=false

# Logging (gunakan LOG_LEVEL=warning atau error di production)
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DAILY_DAYS=14
LOG_LEVEL=debug

# Mail
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@pasarlokal.test"
MAIL_FROM_NAME="${APP_NAME}"

# Midtrans (Sandbox untuk staging/dev, set MIDTRANS_IS_PRODUCTION=true untuk live)
MIDTRANS_IS_ACTIVE=false
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# RajaOngkir V2 / Komerce
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1
RAJAONGKIR_API_KEY=
RAJAONGKIR_ORIGIN_ID=
RAJAONGKIR_TIMEOUT=10

# Password Seeder Awal (hanya isi saat setup awal, hapus setelah login & rotasi password)
SEED_OWNER_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=